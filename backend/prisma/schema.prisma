generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum InvitationPerkType {
  NONE
  COMP
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  slug      String?  @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  themes    Theme[]

  @@map("categories")
}

model InvitationCode {
  id             String             @id @default(cuid())
  code           String             @unique @db.VarChar(50)
  maxUses        Int                @default(1) @map("max_uses")
  usedCount      Int                @default(0) @map("used_count")
  expiresAt      DateTime?          @map("expires_at")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  createdById    String             @map("created_by_id")
  perkType       InvitationPerkType @default(NONE) @map("perk_type")
  perkCompMonths Int?               @map("perk_comp_months")
  user           User               @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("invitation_codes")
}

model MemoTag {
  memoId String @map("memo_id")
  tagId  String @map("tag_id")
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memoId, tagId])
  @@map("memo_tags")
}

model Memo {
  id          String    @id @default(cuid())
  title       String    @db.VarChar(100)
  content     Json
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  trashedAt   DateTime? @map("trashed_at")
  userId      String    @map("user_id")
  notebookId  String?   @map("notebook_id")
  publicToken String?   @unique @map("public_token") @db.VarChar(64)
  publishedAt DateTime? @map("published_at")
  contentText String?   @map("content_text")
  memoTags    MemoTag[]
  notebook    Notebook? @relation(fields: [notebookId], references: [id])
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, publishedAt(sort: Desc)])
  // 一覧/検索のホットパス（where: userId + trashedAt IS NULL, orderBy: updatedAt desc）用。
  // trashedAt を含めることでゴミ箱一覧（trashedAt IS NOT NULL）も同一インデックスで賄う。
  @@index([userId, trashedAt, updatedAt(sort: Desc)])
  @@map("memos")
}

model NotebookTag {
  notebookId String   @map("notebook_id")
  tagId      String   @map("tag_id")
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([notebookId, tagId])
  @@map("notebook_tags")
}

model Notebook {
  id           String        @id @default(cuid())
  name         String?       @db.VarChar(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @map("user_id")
  themeId      String?       @map("theme_id")
  content      Json?
  contentText  String?       @map("content_text")
  memos        Memo[]
  notebookTags NotebookTag[]
  theme        Theme?        @relation(fields: [themeId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@index([userId, updatedAt])
  @@map("notebooks")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(50)
  color        String        @db.VarChar(7)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @map("user_id")
  memoTags     MemoTag[]
  notebookTags NotebookTag[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tags")
}

model Theme {
  id            String              @id @default(cuid())
  name          String              @db.VarChar(50)
  description   String?             @db.VarChar(200)
  isSystem      Boolean             @default(false)
  isPublic      Boolean             @default(false)
  styles        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?             @map("created_by_id")
  cssFilePath   String?             @map("css_file_path") @db.VarChar(255)
  metadata      Json?               @default("{}")
  categoryId    String?             @map("category_id")
  notebooks     Notebook[]
  category      Category?           @relation(fields: [categoryId], references: [id])
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  userFavorites UserFavoriteTheme[]

  @@index([categoryId])
  @@map("themes")
}

model UserFavoriteTheme {
  userId  String @map("user_id")
  themeId String @map("theme_id")
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, themeId])
  @@map("user_favorite_themes")
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String?
  role                   UserRole            @default(USER)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  emailVerificationToken String?             @map("email_verification_token")
  emailVerified          Boolean             @default(false) @map("email_verified")
  password               String?
  resetPasswordExpires   DateTime?           @map("reset_password_expires")
  resetPasswordToken     String?             @map("reset_password_token")
  // Google と GitHub(廃止済み) が共用する識別子。プロバイダ判別列は存在しないため、
  // GitHub 由来の値は次回 Google ログイン時に email 起点合流で googleId へ上書きされる
  // （破壊的削除ではなく列の再利用。Google の識別・ログインには無影響）。
  oauthId                String?             @unique @map("oauth_id")
  // LINE 廃止後も監査・復旧・将来の再有効化に備えて列とデータを非破壊で保持する
  // （書き込み経路のみ廃止。マイグレーションでの削除は行わない）。
  lineId                 String?             @unique @map("line_id")
  appleId                String?             @unique @map("apple_id")
  xId                    String?             @unique @map("x_id")
  invitationQuota        Int                 @default(5) @map("invitation_quota")
  feedbacks              Feedback[]
  invitationCodes        InvitationCode[]
  memos                  Memo[]
  notebooks              Notebook[]
  refreshTokens          RefreshToken[]
  tags                   Tag[]
  themes                 Theme[]
  userFavoriteThemes     UserFavoriteTheme[]
  mcpAuthCodes           McpAuthCode[]
  mcpRefreshTokens       McpRefreshToken[]

  @@map("users")
}

model McpOAuthClient {
  id                      String            @id @default(cuid())
  clientName              String            @map("client_name") @db.VarChar(255)
  redirectUris            String[]          @map("redirect_uris")
  grantTypes              String[]          @map("grant_types")
  tokenEndpointAuthMethod String            @default("none") @map("token_endpoint_auth_method") @db.VarChar(100)
  clientSecretHash        String?           @map("client_secret_hash") @db.VarChar(64)
  createdAt               DateTime          @default(now()) @map("created_at")
  updatedAt               DateTime          @updatedAt @map("updated_at")
  authCodes               McpAuthCode[]
  refreshTokens           McpRefreshToken[]

  @@map("mcp_oauth_clients")
}

model McpAuthCode {
  code                String         @id
  clientId            String         @map("client_id")
  userId              String         @map("user_id")
  redirectUri         String         @map("redirect_uri")
  codeChallenge       String         @map("code_challenge")
  codeChallengeMethod String         @default("S256") @map("code_challenge_method") @db.VarChar(10)
  scope               String
  resource            String
  expiresAt           DateTime       @map("expires_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  client              McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("mcp_auth_codes")
}

model McpRefreshToken {
  id        String         @id @default(cuid())
  tokenHash String         @unique @map("token_hash") @db.VarChar(64)
  clientId  String         @map("client_id")
  userId    String         @map("user_id")
  scope     String
  expiresAt DateTime       @map("expires_at")
  rotatedAt DateTime?      @map("rotated_at")
  revokedAt DateTime?      @map("revoked_at")
  createdAt DateTime       @default(now()) @map("created_at")
  client    McpOAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([userId])
  @@map("mcp_refresh_tokens")
}

model Feedback {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  category  FeedbackCategory
  message   String
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model RefreshToken {
  id         String             @id @default(cuid())
  userId     String             @map("user_id")
  tokenHash  String             @unique @map("token_hash") @db.VarChar(64)
  familyId   String             @map("family_id") @db.Uuid
  status     RefreshTokenStatus @default(active)
  issuedAt   DateTime           @default(now()) @map("issued_at")
  expiresAt  DateTime           @map("expires_at")
  lastUsedAt DateTime?          @map("last_used_at")
  ip         String?            @db.VarChar(45)
  userAgent  String?            @map("user_agent") @db.VarChar(512)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([familyId])
  @@map("refresh_tokens")
}

enum UserRole {
  USER
  ADMIN
}

enum RefreshTokenStatus {
  active
  rotated
  revoked
}

enum FeedbackCategory {
  bug
  improvement
  other
}
