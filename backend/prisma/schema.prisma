// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  FREE
  PREMIUM
  ADMIN
}

model User {
  id          String   @id @default(cuid())
  supabaseId  String?  @unique @map("supabase_id") // Supabaseからの移行時のみ使用
  email       String   @unique
  password    String?  // 新規追加：ハッシュ化されたパスワード
  name        String?
  role        UserRole @default(FREE)
  
  // 認証関連フィールド
  emailVerified        Boolean   @default(false) @map("email_verified")
  emailVerificationToken String? @map("email_verification_token")
  resetPasswordToken     String? @map("reset_password_token")
  resetPasswordExpires   DateTime? @map("reset_password_expires")
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  memos             Memo[]
  tags              Tag[]
  createdInviteCodes InvitationCode[]
  createdThemes     Theme[]
  favoriteThemes    UserFavoriteTheme[]
  
  @@map("users")
}

model Memo {
  id        String   @id @default(cuid())
  title     String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  themeId   String?  @map("theme_id")
  theme     Theme?   @relation(fields: [themeId], references: [id], onDelete: SetNull)
  
  memoTags  MemoTag[]
  
  @@map("memos")
}

model InvitationCode {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(50)
  maxUses     Int       @default(1) @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  @@map("invitation_codes")
}

model Tag {
  id        String   @id @default(cuid())
  name      String   @db.VarChar(50)
  color     String   @db.VarChar(7) // Hex color code like #FF5733
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  memoTags  MemoTag[]
  
  @@map("tags")
}

model MemoTag {
  memoId String @map("memo_id")
  tagId  String @map("tag_id")
  
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@id([memoId, tagId])
  @@map("memo_tags")
}

model Theme {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(50)
  description String?  @db.VarChar(200)
  isSystem    Boolean  @default(false)
  isPublic    Boolean  @default(false)
  
  // スタイル設定（JSON形式）
  styles      Json
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // 作成者（システムテーマの場合はnull）
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  // リレーション
  memos           Memo[]
  userFavorites   UserFavoriteTheme[]
  
  @@map("themes")
}

model UserFavoriteTheme {
  userId  String @map("user_id")
  themeId String @map("theme_id")
  
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  
  @@id([userId, themeId])
  @@map("user_favorite_themes")
}
