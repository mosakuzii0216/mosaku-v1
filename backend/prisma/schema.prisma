generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model categories {
  id        String   @id
  name      String   @unique @db.VarChar(50)
  slug      String?  @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime
  themes    themes[]
}

model invitation_codes {
  id            String    @id
  code          String    @unique @db.VarChar(50)
  max_uses      Int       @default(1)
  used_count    Int       @default(0)
  expires_at    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  created_by_id String
  users         users     @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
}

model memo_tags {
  memo_id String
  tag_id  String
  memos   memos  @relation(fields: [memo_id], references: [id], onDelete: Cascade)
  tags    tags   @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([memo_id, tag_id])
}

model memos {
  id          String      @id
  title       String      @db.VarChar(100)
  content     String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime
  user_id     String
  notebook_id String?
  memo_tags   memo_tags[]
  notebooks   notebooks?  @relation(fields: [notebook_id], references: [id])
  users       users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model notebook_tags {
  notebook_id String
  tag_id      String
  notebooks   notebooks @relation(fields: [notebook_id], references: [id], onDelete: Cascade)
  tags        tags      @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@id([notebook_id, tag_id])
}

model notebooks {
  id            String          @id
  name          String?         @db.VarChar(100)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  user_id       String
  theme_id      String?
  content       String?
  memos         memos[]
  notebook_tags notebook_tags[]
  themes        themes?         @relation(fields: [theme_id], references: [id])
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, name])
  @@index([user_id, updatedAt])
}

model tags {
  id            String          @id
  name          String          @db.VarChar(50)
  color         String          @db.VarChar(7)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime
  user_id       String
  memo_tags     memo_tags[]
  notebook_tags notebook_tags[]
  users         users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model themes {
  id                   String                 @id
  name                 String                 @db.VarChar(50)
  description          String?                @db.VarChar(200)
  isSystem             Boolean                @default(false)
  isPublic             Boolean                @default(false)
  styles               Json?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  created_by_id        String?
  css_file_path        String?                @db.VarChar(255)
  metadata             Json?                  @default("{}")
  category_id          String?
  notebooks            notebooks[]
  categories           categories?            @relation(fields: [category_id], references: [id])
  users                users?                 @relation(fields: [created_by_id], references: [id], onDelete: Cascade)
  user_favorite_themes user_favorite_themes[]

  @@index([category_id])
}

model user_favorite_themes {
  user_id  String
  theme_id String
  themes   themes @relation(fields: [theme_id], references: [id], onDelete: Cascade)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, theme_id])
}

model users {
  id                       String                 @id
  email                    String                 @unique
  name                     String?
  role                     UserRole               @default(FREE)
  createdAt                DateTime               @default(now())
  updatedAt                DateTime
  email_verification_token String?
  email_verified           Boolean                @default(false)
  password                 String?
  reset_password_expires   DateTime?
  reset_password_token     String?
  oauth_id                 String?                @unique
  invitation_codes         invitation_codes[]
  memos                    memos[]
  notebooks                notebooks[]
  tags                     tags[]
  themes                   themes[]
  user_favorite_themes     user_favorite_themes[]
}

enum UserRole {
  FREE
  PREMIUM
  ADMIN
}
