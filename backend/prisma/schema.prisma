generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique @db.VarChar(50)
  slug      String?  @unique @db.VarChar(50)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  themes    Theme[]

  @@map("categories")
}

model InvitationCode {
  id          String    @id @default(cuid())
  code        String    @unique @db.VarChar(50)
  maxUses     Int       @default(1) @map("max_uses")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdById String    @map("created_by_id")
  user        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@map("invitation_codes")
}

model MemoTag {
  memoId String @map("memo_id")
  tagId  String @map("tag_id")
  memo   Memo   @relation(fields: [memoId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([memoId, tagId])
  @@map("memo_tags")
}

model Memo {
  id         String    @id @default(cuid())
  title      String    @db.VarChar(100)
  content    String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  userId     String    @map("user_id")
  notebookId String?   @map("notebook_id")
  memoTags   MemoTag[]
  notebook   Notebook? @relation(fields: [notebookId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memos")
}

model NotebookTag {
  notebookId String   @map("notebook_id")
  tagId      String   @map("tag_id")
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  tag        Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([notebookId, tagId])
  @@map("notebook_tags")
}

model Notebook {
  id           String        @id @default(cuid())
  name         String?       @db.VarChar(100)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @map("user_id")
  themeId      String?       @map("theme_id")
  content      String?
  memos        Memo[]
  notebookTags NotebookTag[]
  theme        Theme?        @relation(fields: [themeId], references: [id])
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, name])
  @@index([userId, updatedAt])
  @@map("notebooks")
}

model Tag {
  id           String        @id @default(cuid())
  name         String        @db.VarChar(50)
  color        String        @db.VarChar(7)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  userId       String        @map("user_id")
  memoTags     MemoTag[]
  notebookTags NotebookTag[]
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tags")
}

model Theme {
  id            String              @id @default(cuid())
  name          String              @db.VarChar(50)
  description   String?             @db.VarChar(200)
  isSystem      Boolean             @default(false)
  isPublic      Boolean             @default(false)
  styles        Json?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  createdById   String?             @map("created_by_id")
  cssFilePath   String?             @map("css_file_path") @db.VarChar(255)
  metadata      Json?               @default("{}")
  categoryId    String?             @map("category_id")
  notebooks     Notebook[]
  category      Category?           @relation(fields: [categoryId], references: [id])
  createdBy     User?               @relation(fields: [createdById], references: [id], onDelete: Cascade)
  userFavorites UserFavoriteTheme[]

  @@index([categoryId])
  @@map("themes")
}

model UserFavoriteTheme {
  userId  String @map("user_id")
  themeId String @map("theme_id")
  theme   Theme  @relation(fields: [themeId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, themeId])
  @@map("user_favorite_themes")
}

model User {
  id                     String              @id @default(cuid())
  email                  String              @unique
  name                   String?
  role                   UserRole            @default(USER)
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  emailVerificationToken String?             @map("email_verification_token")
  emailVerified          Boolean             @default(false) @map("email_verified")
  password               String?
  resetPasswordExpires   DateTime?           @map("reset_password_expires")
  resetPasswordToken     String?             @map("reset_password_token")
  oauthId                String?             @unique @map("oauth_id")
  invitationCodes        InvitationCode[]
  memos                  Memo[]
  notebooks              Notebook[]
  tags                   Tag[]
  themes                 Theme[]
  userFavoriteThemes     UserFavoriteTheme[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}
