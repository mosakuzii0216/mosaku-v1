# Supabase settings
DATABASE_URL=[SUPABASE DATABASE URL]
DIRECT_URL=[SUPABASE DIRECT URL]

# Supabase API settings
SUPABASE_URL=[SUPABASE PROJECT URL]
SUPABASE_ANON_KEY=[SUPABASE ANON KEY]

# Frontend settings
VITE_SUPABASE_URL=[SUPABASE PROJECT URL]
VITE_SUPABASE_ANON_KEY=[SUPABASE ANON KEY]
VITE_APP_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:3000

# Admin settings
ADMIN_EMAIL=[SUPABASE ADMIN EMAIL]

# Authentication settings (既存認証 - 第2段階で削除予定)
JWT_SECRET=your-secret-key-change-this-in-production

# Session Settings (for X OAuth)
SESSION_SECRET=your-session-secret-change-this-in-production

# Google OAuth Settings
# For Backend
GOOGLE_CLIENT_ID=[GOOGLE CLIENT ID]
GOOGLE_CLIENT_SECRET=[GOOGLE CLIENT SECRET]
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# For Frontend (Vite requires VITE_ prefix)
VITE_GOOGLE_CLIENT_ID=[GOOGLE CLIENT ID]

# GitHub OAuth Settings
# For Backend
GITHUB_CLIENT_ID=[GITHUB CLIENT ID]
GITHUB_CLIENT_SECRET=[GITHUB CLIENT SECRET]
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# For Frontend (Vite requires VITE_ prefix)
VITE_GITHUB_CLIENT_ID=[GITHUB CLIENT ID]
# X OAuth Settings
# For Backend
X_CONSUMER_KEY=[X CONSUMER KEY]
X_CONSUMER_SECRET=[X CONSUMER SECRET]
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# For Frontend (Vite requires VITE_ prefix)
VITE_X_CONSUMER_KEY=[X CONSUMER KEY]