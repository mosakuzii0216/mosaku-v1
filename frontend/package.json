{
	"name": "frontend",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "vite",
		"build": "tsc -b && vite build",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"preview": "vite preview",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"check:precache": "node scripts/check-precache-size.mjs",
		"bench": "vitest run --config vitest.bench.config.ts",
		"bench:search": "vitest run --config vitest.bench.config.ts src/utils/offline/repository.search.bench.ts",
		"bench:sync": "vitest run --config vitest.bench.config.ts src/utils/sync/sync-engine.throughput.bench.ts"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.1.1",
		"@sentry/react": "^10.47.0",
		"@tanstack/react-query": "^5.81.2",
		"@tiptap/extension-code-block-lowlight": "3.22.2",
		"@tiptap/extension-details": "3.22.2",
		"@tiptap/extension-highlight": "3.22.2",
		"@tiptap/extension-list": "3.22.2",
		"@tiptap/extension-mention": "3.22.2",
		"@tiptap/extension-placeholder": "3.22.2",
		"@tiptap/extension-table": "3.22.2",
		"@tiptap/extension-text-style": "3.22.2",
		"@tiptap/pm": "3.23.4",
		"@tiptap/react": "3.22.2",
		"@tiptap/starter-kit": "3.22.2",
		"@tiptap/suggestion": "3.22.2",
		"idb": "^8.0.3",
		"lowlight": "^3.3.0",
		"lucide-react": "^0.554.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"react-hook-form": "^7.58.1",
		"react-router": "^7.14.0",
		"tippy.js": "^6.3.7",
		"zod": "^3.25.67",
		"zustand": "^5.0.5"
	},
	"devDependencies": {
		"@eslint/js": "^9.25.0",
		"@playwright/test": "^1.59.1",
		"@sentry/vite-plugin": "^5.2.0",
		"@tailwindcss/typography": "^0.5.19",
		"@testing-library/react": "^16.3.2",
		"@tiptap/html": "^3.22.2",
		"@types/node": "^25.6.2",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^5.1.2",
		"autoprefixer": "^10.4.21",
		"eslint": "^9.25.0",
		"eslint-plugin-react-hooks": "^5.2.0",
		"eslint-plugin-react-refresh": "^0.4.19",
		"fake-indexeddb": "^6.2.5",
		"globals": "^16.0.0",
		"jsdom": "^29.0.1",
		"postcss": "^8.5.6",
		"prettier": "^3.4.2",
		"tailwindcss": "^3.4.17",
		"typescript": "~5.8.3",
		"typescript-eslint": "^8.30.1",
		"vite": "^6.3.5",
		"vite-plugin-pwa": "^1.0.3",
		"vitest": "^4.1.2"
	},
	"overrides": {
		"@tiptap/core": "3.23.4",
		"@tiptap/pm": "3.23.4"
	}
}
