# =========================================
# Mosaku Environment Configuration Template
# =========================================
# Copy this file to .env and fill in your values
# For production, set values in your deployment platform (Vercel, Cloud Run)

# -----------------------------------------
# Database (Supabase PostgreSQL)
# -----------------------------------------
# Connection pooling URL (for application queries)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-1-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
# Direct connection URL (for migrations)
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres?schema=public

# Supabase API (optional - for frontend SDK)
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# -----------------------------------------
# Observability / Monitoring
# -----------------------------------------
# DB コネクションプール使用率メトリクス（db_pool_utilization）の分母。
# DbPoolObservabilityService が util_ratio = used / max を算出する際の max に使う。
# 未設定なら Postgres の max_connections にフォールバックするが、pooler（pgBouncer）の
# 多重化でプール枯渇を過小評価するため、本番では Supabase の Pool Size を設定すること。
# 参考: docs/deployment/memo-public-isolation-runbook.md §2.4
DB_POOL_MAX_CONNECTIONS=15

# -----------------------------------------
# Authentication
# -----------------------------------------
JWT_SECRET=your-secret-key-change-this-in-production
SESSION_SECRET=your-session-secret-change-this-in-production

# Access Token TTL (default: 15m). Refresh Token 導入に合わせて短命化
JWT_EXPIRATION=15m

# 招待 OAuth フロー（state 引き継ぎ）の HMAC 署名鍵。JWT_SECRET と必ず分離すること。
# 未設定なら起動時に fail-fast（環境問わず必須）。
# 生成例: openssl rand -hex 32
INVITATION_STATE_SECRET=

# Admin user (this email gets ADMIN role automatically)
ADMIN_EMAIL=your_admin_email@example.com

# -----------------------------------------
# Refresh Token (auto-login)
# -----------------------------------------
# Refresh Token hashing pepper. 本番環境では必ず設定（未設定なら起動時 fail-fast）
# 例: openssl rand -base64 48 などで生成した 32 バイト以上のランダム値
REFRESH_TOKEN_PEPPER=
# Refresh Token TTL (default: 30d)
REFRESH_TOKEN_EXPIRATION=30d
# Cookie 属性。env 未指定なら開発 secure=false / 本番 secure=true、SameSite=lax
REFRESH_COOKIE_DOMAIN=
REFRESH_COOKIE_SAMESITE=lax
REFRESH_COOKIE_SECURE=
# /auth/refresh のレート制限（既定: 60 秒で 10 回まで）
REFRESH_THROTTLE_LIMIT=10
REFRESH_THROTTLE_TTL=60000

# -----------------------------------------
# Google OAuth
# -----------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# -----------------------------------------
# GitHub OAuth
# -----------------------------------------
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:3000/auth/github/callback

# -----------------------------------------
# X (Twitter) OAuth (currently disabled)
# -----------------------------------------
X_CONSUMER_KEY=your_x_consumer_key_here
X_CONSUMER_SECRET=your_x_consumer_secret_here
X_REDIRECT_URI=http://localhost:3000/auth/x/callback

# -----------------------------------------
# Frontend (Vite - requires VITE_ prefix)
# -----------------------------------------
VITE_APP_URL=http://localhost:5173
VITE_BACKEND_URL=http://localhost:3000

# Supabase (frontend SDK)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# OAuth Client IDs (frontend needs these for OAuth flow initiation)
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_X_CONSUMER_KEY=your_x_consumer_key_here

# -----------------------------------------
# Feature Flags (optional)
# -----------------------------------------
# Backend features
FEATURE_PAGINATION=true
FEATURE_PASSWORD_RESET_EMAIL=false
FEATURE_OAUTH_X=false
FEATURE_PREMIUM=false
FEATURE_LEGACY_SYNC=true
FEATURE_VERBOSE_LOGGING=false

# Frontend features
VITE_FEATURE_PAGINATION_UI=true
VITE_FEATURE_PASSWORD_RESET=true
VITE_FEATURE_OAUTH_X=false
VITE_FEATURE_PREMIUM_UI=false
VITE_FEATURE_DEV_TOOLS=false
VITE_FEATURE_THEME_CUSTOMIZATION=false

# -----------------------------------------
# CORS (production only)
# -----------------------------------------
# Comma-separated list of allowed origins
# CORS_ORIGINS=https://your-frontend-domain.com
