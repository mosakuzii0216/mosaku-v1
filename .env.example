# PostgreSQL Settings
POSTGRES_USER=myuser
POSTGRES_PASSWORD=mypassword
POSTGRES_DB=memodb
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public"

# Admin Settings
ADMIN_EMAIL=your-admin-email@example.com

# JWT Settings
JWT_SECRET=your-jwt-secret-key-minimum-32-characters

# Google OAuth Settings
# Get these from Google Cloud Console (https://console.cloud.google.com/)
# 1. Create a new project or select existing project
# 2. Enable Google+ API and People API
# 3. Go to Credentials > Create credentials > OAuth 2.0 Client ID
# 4. Set application type to "Web application"
# 5. Add redirect URI: http://localhost/api/auth/google/callback

# For Backend
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost/api/auth/google/callback

# For Frontend (Vite requires VITE_ prefix)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_APP_URL=http://localhost

# GitHub OAuth Settings
# Get these from GitHub Developer Settings (https://github.com/settings/developers)
# 1. Go to Settings > Developer settings > OAuth Apps
# 2. Click "New OAuth App"
# 3. Set application name: "Mosaku Memo App"
# 4. Set homepage URL: http://localhost
# 5. Set authorization callback URL: http://localhost/api/auth/github/callback

# For Backend
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
GITHUB_REDIRECT_URI=http://localhost/api/auth/github/callback

# For Frontend (Vite requires VITE_ prefix)
VITE_GITHUB_CLIENT_ID=your-github-client-id